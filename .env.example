# Copy to .env.local for local development. Never commit real values.
# In production, set these as SENSITIVE environment variables in Vercel so the
# value is write-only and never shows up in logs or the dashboard UI.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Absolute origin of the deployed site, no trailing slash. Read by
# lib/site.ts for metadataBase, the canonical URL, and the structured data.
# Optional on Vercel: when unset, the project's production URL
# (VERCEL_PROJECT_PRODUCTION_URL, which Vercel sets automatically) is used,
# and locally it falls back to http://localhost:3000. Set it once the custom
# domain is attached so the canonical URL is the domain, not the *.vercel.app
# alias.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Payments (Stripe Checkout)
# ---------------------------------------------------------------------------
# Required to sell. Without it POST /api/checkout returns
# { code: "payments_not_configured" } and the cart shows "Checkout isn't
# switched on yet." Thread uses the Lee Enterprises Unlimited Stripe account;
# its sessions and payments are tagged metadata.site = "thread".
#
# Use the TEST key (sk_test_...) locally and on Preview, and the live key
# (sk_live_...) on Production only. A restricted key works too, with write
# access to Checkout Sessions and nothing else.
STRIPE_SECRET_KEY=
